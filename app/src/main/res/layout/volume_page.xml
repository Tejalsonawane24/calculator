<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0715"
    tools:context=".VolumePage"
    android:fitsSystemWindows="true">

    <ImageButton
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:id="@+id/btnBackvp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/ic_media_previous"
        app:tint="?attr/calcButtonText"
        android:backgroundTint="?attr/calcButtonBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:onClick="showMeasurements"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/Texttitlevp"
        android:text="Length Convertor"
        android:textColor="?attr/calcButtonText"
        android:backgroundTint="?attr/calcButtonBackground"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/btnBackvp"
        app:layout_constraintTop_toTopOf="@+id/btnBackvp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/topContainervp"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintTop_toBottomOf="@+id/btnBackvp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="?attr/calcButtonBackground">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:backgroundTint="?attr/calcButtonBackground">
            <Spinner
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/spv1"
                android:minHeight="45dp"
                android:textColor="?attr/calcButtonText"
                android:backgroundTint="?attr/calcButtonBackground"/>
            <EditText
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/edvc1"
                android:backgroundTint="?attr/calcButtonBackground"
                android:textColor="?attr/calcButtonText"
                android:textSize="24sp"
                android:text="100"
                android:textStyle="bold"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/card_bg"
            android:backgroundTint="?attr/calcButtonBackground"
            android:orientation="vertical"
            android:padding="10dp">
            <Spinner
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/spvc2"
                android:minHeight="45dp"
                android:textColor="?attr/calcButtonText"
                android:backgroundTint="?attr/calcButtonBackground"/>
            <EditText
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="?attr/calcButtonBackground"
                android:textColor="?attr/calcButtonText"
                android:textSize="24sp"
                android:text="100"
                android:textStyle="bold"
                android:id="@+id/edvc2"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintTop_toBottomOf="@+id/topContainervp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/vspace1"/>
    <GridLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/keypadvp"
        android:columnCount="4"
        android:rowCount="4"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@+id/vspace1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <Button
            android:id="@+id/vcbtn7"
            style="@style/KeyButton"
            android:text="7"/>
        <Button
            android:id="@+id/vcbtn8"
            style="@style/KeyButton"
            android:text="8"/>
        <Button
            android:id="@+id/vcbtn9"
            style="@style/KeyButton"
            android:text="9"/>
        <Button
            android:id="@+id/vcbtnAC"
            style="@style/SideButton"
            android:text="AC"
            android:layout_rowSpan="2"/>
        <Button
            android:id="@+id/vcbtn4"
            style="@style/KeyButton"
            android:text="4"/>
        <Button
            android:id="@+id/vcbtn5"
            style="@style/KeyButton"
            android:text="5"/>
        <Button
            android:id="@+id/vcbtn6"
            style="@style/KeyButton"
            android:text="6"/>
        <Button
            android:id="@+id/vcbtn1"
            style="@style/KeyButton"
            android:text="1"/>
        <Button
            android:id="@+id/vcbtn2"
            style="@style/KeyButton"
            android:text="2"/>
        <Button
            android:id="@+id/vcbtn3"
            style="@style/KeyButton"
            android:text="3"/>
        <Button
            android:id="@+id/vcbtndelete"
            style="@style/SideButton"
            android:text="⌫"
            android:layout_rowSpan="2"/>
        <Button
            android:id="@+id/vcbtn00"
            style="@style/KeyButton"
            android:text="00"
            android:textSize="18sp"/>
        <Button
            android:id="@+id/vcbtn0"
            style="@style/KeyButton"
            android:text="0"/>
        <Button
            android:id="@+id/vcbtndot"
            style="@style/KeyButton"
            android:text="."/>
    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>