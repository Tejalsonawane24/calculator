<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0715"
    tools:context=".CurrencyPage"
    android:fitsSystemWindows="true">

    <!-- BACK BUTTON -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/ic_media_previous"
        app:tint="?attr/calcButtonText"
        android:backgroundTint="?attr/calcButtonBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:onClick="showMeasurements"/>

    <!-- TITLE -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Currency converter"
        android:textColor="?attr/calcButtonText"
        android:backgroundTint="?attr/calcButtonBackground"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        />

    <!-- TOP CARD AREA -->
    <LinearLayout
        android:id="@+id/topContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="?attr/calcButtonBackground">

        <!-- LEFT CARDS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:backgroundTint="?attr/calcButtonBackground">

            <!-- FROM CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="10dp"
                android:backgroundTint="?attr/calcButtonBackground">

                <Spinner
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/sp1"
                    android:minHeight="45dp"
                    android:textColor="?attr/calcButtonText"
                    android:backgroundTint="?attr/calcButtonBackground"/>

                <EditText
                    android:id="@+id/edcc1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/calcButtonBackground"
                    android:textColor="?attr/calcButtonText"
                    android:textSize="24sp"
                    android:text="100"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- SPACE -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp"/>

            <!-- TO CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/card_bg"
                android:backgroundTint="?attr/calcButtonBackground"
                android:orientation="vertical"
                android:padding="10dp">

                <Spinner
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/sp2"
                    android:minHeight="45dp"
                    android:textColor="?attr/calcButtonText"
                    android:backgroundTint="?attr/calcButtonBackground"/>

                <EditText
                    android:id="@+id/edcc2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/calcButtonBackground"
                    android:textColor="?attr/calcButtonText"
                    android:textSize="24sp"
                    android:text="100"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <!-- SWAP BUTTON -->
        <LinearLayout
            android:id="@+id/btnSwap"
            android:layout_width="70dp"
            android:layout_height="230dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/stat_notify_sync"
                android:tint="@android:color/white"/>
        </LinearLayout>

    </LinearLayout>

    <!-- LAST UPDATED -->
    <TextView
        android:id="@+id/txtUpdated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Last updated: 17/05/2026, 12:45"
        android:textColor="#8E8E8E"
        android:textSize="12sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/topContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- KEYPAD -->
    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="4"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtUpdated"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ROW 1 -->
        <Button
            android:id="@+id/btn7"
            style="@style/KeyButton"
            android:text="7"/>

        <Button
            android:id="@+id/btn8"
            style="@style/KeyButton"
            android:text="8"/>

        <Button
            android:id="@+id/btn9"
            style="@style/KeyButton"
            android:text="9"/>

        <Button
            android:id="@+id/btnAC"
            style="@style/SideButton"
            android:text="AC"
            android:layout_rowSpan="2"/>

        <!-- ROW 2 -->
        <Button
            android:id="@+id/btn4"
            style="@style/KeyButton"
            android:text="4"/>

        <Button
            android:id="@+id/btn5"
            style="@style/KeyButton"
            android:text="5"/>

        <Button
            android:id="@+id/btn6"
            style="@style/KeyButton"
            android:text="6"/>

        <!-- ROW 3 -->
        <Button
            android:id="@+id/btn1"
            style="@style/KeyButton"
            android:text="1"/>

        <Button
            android:id="@+id/btn2"
            style="@style/KeyButton"
            android:text="2"/>

        <Button
            android:id="@+id/btn3"
            style="@style/KeyButton"
            android:text="3"/>

        <Button
            android:id="@+id/btnDelete"
            style="@style/SideButton"
            android:text="⌫"
            android:layout_rowSpan="2"/>

        <!-- ROW 4 -->
        <Button
            android:id="@+id/btn00"
            style="@style/KeyButton"
            android:text="00"/>

        <Button
            android:id="@+id/btn0"
            style="@style/KeyButton"
            android:text="0"/>

        <Button
            android:id="@+id/btnDot"
            style="@style/KeyButton"
            android:text="."/>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>